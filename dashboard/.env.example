# Same Supabase project as ../frontend. Public values only — access is enforced
# by Row Level Security (public.is_admin()), so the service role key must never
# be added to this app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Where the storefront app runs — its /api/fib/admin/* routes hold the FIB
# secrets and are what this app calls for refund/cancel-payment actions.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
